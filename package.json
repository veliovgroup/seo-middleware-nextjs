    "ostr.io",
    "next",
    "nextjs",
    "next.js",
    "ssr",
    "server side rendering",
    "_escaped_fragment_"
  ],
  "homepage": "https://github.com/veliovgroup/seo-middleware-nextjs",
  "bugs": {
    "url": "https://github.com/veliovgroup/seo-middleware-nextjs/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "dr.dimitru (https://veliovgroup.com)",
  "license": "BSD-3-Clause",
