{
  "name": "seo-middleware-nextjs",
  "version": "1.1.1",
  "description": "Next.js SEO — boosting organic traffic from SERPs, AI Chat Bots, and GPT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "npm run build && npm run test:types && node --test test/*.test.mjs",
    "test:types": "tsc -p test/tsconfig.json --noEmit",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=dist/index.js --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/veliovgroup/seo-middleware-nextjs.git"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "keywords": [
    "SEO",
    "middleware",
    "web vitals",
    "lighthouse",
    "spiderable",
    "crawl",
    "crawlable",
    "prerender",
    "pre-rendering",
    "prerendering",
    "ostrio",
    "ostr.io",
    "next",
    "nextjs",
    "next.js",
    "ssr",
    "server side rendering",
    "_escaped_fragment_"
  ],
  "tags": [
    "SEO",
    "middleware",
    "web vitals",
    "lighthouse",
    "spiderable",
    "crawl",
    "crawlable",
